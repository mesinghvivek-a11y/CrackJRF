{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ugcnet-question-record.schema.json",
  "title": "UGC NET canonical question import record",
  "type": "object",
  "required": ["schema_version", "question_code", "subject_code", "question_type", "translations", "classifications", "exam_appearances", "source_provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "question_code": {"type":"string","pattern":"^[A-Z0-9-]{6,64}$"},
    "subject_code": {"type":"string"},
    "question_type": {"enum":["mcq","comprehension","table","image","map","matrix","numeric","other"]},
    "status": {"enum":["draft","needs_correction","content_verified","answer_pending","ready_for_approval","published","rejected"]},
    "translations": {"type":"array","minItems":1,"items":{"type":"object","required":["language","stem_blocks"],"properties":{"language":{"enum":["en","hi"]},"stem_blocks":{"type":"array","items":{"$ref":"#/$defs/contentBlock"}},"options":{"type":"array","items":{"type":"object","required":["key","content_blocks"],"properties":{"key":{"enum":["A","B","C","D"]},"content_blocks":{"type":"array","items":{"$ref":"#/$defs/contentBlock"}}}}}}}},
    "classifications":{"type":"array","minItems":1,"items":{"type":"object","required":["node_id"],"properties":{"node_id":{"type":"string"},"is_primary":{"type":"boolean"}}}},
    "exam_appearances":{"type":"array","items":{"type":"object","required":["year","session","paper_number","original_question_number"],"properties":{"year":{"type":"integer"},"session":{"enum":["June","December","Other"]},"exam_event_type":{"enum":["regular","re_exam","special","unknown"]},"paper_number":{"enum":[1,2]},"shift":{"type":["string","null"]},"exam_date":{"type":["string","null"],"format":"date"},"original_question_number":{"type":"string"},"nta_question_id":{"type":["string","null"]},"source_document_id":{"type":["string","null"]},"source_page":{"type":["integer","null"]}}}},
    "answer_evidence":{"type":"array","items":{"type":"object","properties":{"source_document_id":{"type":["string","null"]},"source_question_number":{"type":["string","null"]},"claimed_option_keys":{"type":"array","items":{"enum":["A","B","C","D"]}},"explanation":{"type":"string"},"verification_status":{"enum":["unverified","accepted","rejected","disputed"]}}}},
    "verified_answer":{"type":["object","null"],"properties":{"correct_option_keys":{"type":"array","items":{"enum":["A","B","C","D"]}},"answer_status":{"enum":["single_correct","multiple_correct","all_options_correct","dropped"]},"grading_rule":{"enum":["normal","all_candidates_credit","dropped_credit","no_score"]},"explanation_overview":{"type":"string"},"explanation_richtext":{"type":"array"},"option_explanations":{"type":"object"},"references":{"type":"array"}}},
    "source_provenance":{"type":"array","items":{"type":"object","required":["source_type"],"properties":{"source_type":{"enum":["nta_official","private_solution","official_answer_key","editorial","other"]},"source_document":{"type":"string"},"page":{"type":"integer"},"source_question_number":{"type":"string"}}}}
  },
  "$defs":{"contentBlock":{"type":"object","required":["type"],"properties":{"type":{"enum":["paragraph","table","image","math","list","html"]},"text":{"type":"string"},"html":{"type":"string"},"latex":{"type":"string"},"columns":{"type":"array","items":{"type":"string"}},"rows":{"type":"array","items":{"type":"array","items":{"type":"string"}}},"asset_path":{"type":"string"},"alt":{"type":"string"}}}}
}
